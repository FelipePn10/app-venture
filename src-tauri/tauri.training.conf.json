{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ERP Venture (Treinamento)",
  "identifier": "com.venture.erp.training",
  "build": {
    "beforeDevCommand": "npm run dev:training",
    "beforeBuildCommand": "npm run build:training",
    "devUrl": "http://localhost:5174"
  },
  "app": {
    "windows": [
      {
        "title": "ERP Venture — Ambiente de Treinamento",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "minWidth": 1024,
        "minHeight": 680,
        "label": "main",
        "decorations": false
      }
    ]
  },
  "bundle": {
    "createUpdaterArtifacts": false
  }
}
