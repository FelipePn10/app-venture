# Ambiente de produção: `npm run build` / `npm run build:production`.
#
# VITE_API_URL fica VAZIO de propósito. Um único instalador atende todas as
# empresas clientes, e o servidor é resolvido em execução pelo domínio do e-mail
# digitado no login (src/services/tenantDirectory.ts). Preencher esta variável
# fixa o app numa empresa só e volta a exigir um instalador por cliente.
VITE_API_URL=
# Catálogo de empresas: domínio de e-mail → endereço da API. Publicado em domínio
# da Venture, para que um cliente novo entre sem nova versão do desktop.
VITE_TENANT_DIRECTORY_URL=https://app.venturerp.com/tenants.json
VITE_API_TIMEOUT_MS=15000
VITE_USE_MOCK_AUTH=false
VITE_AUTH_LOGIN_PATH=/users/login
# VITE_AUTH_ME_PATH — endpoint de perfil do usuario. Fica VAZIO de proposito:
# o backend nao expoe /users/me, e apontar para ele fazia o app disparar dois
# 404 por abertura numa rota com limite de taxa. Nome, e-mail e perfil ja vem do
# login e dos claims do JWT. Preencha quando existir um endpoint de identidade.
VITE_AUTH_ME_PATH=
VITE_AUTH_LOGIN_FIELD=email
VITE_WAREHOUSE_ENDPOINT=/almoxarifados
VITE_CUSTOMER_LOOKUP_PATH=/clientes
VITE_SUPPLIER_LOOKUP_PATH=/fornecedores
VITE_ESTABLISHMENT_LOOKUP_PATH=/estabelecimentos
