# ==========================================================================
# Ambiente de TREINAMENTO — VentureERP
# Aponta o front para o backend de treinamento (banco e credenciais próprios,
# populado com ~1 ano de operação fictícia). Isolado de produção/demo/dev.
#
# Suba o backend primeiro (no repo da API):  make training-bootstrap
# Depois rode o front em modo treinamento:   npm run dev:training
#
# Login: instrutor@venturerp.training (senha em deploy/training/training.env,
# chave TRAINING_ADMIN_PASSWORD) e aluno01..alunoNN@venturerp.training
# (senha TRAINING_TRAINEE_PASSWORD).
# ==========================================================================

# Porta própria do dev server: permite rodar treinamento e demo/dev ao mesmo
# tempo (demo/dev ficam na 5173).
VITE_DEV_PORT=5174

# VITE_API_URL vazio de propósito: o front usa URLs relativas e o proxy do Vite
# (vite.config.ts) encaminha /api, /users, etc. para o PROXY_TARGET no lado
# servidor — sem CORS no meio.
VITE_API_URL=
VITE_API_PROXY_TARGET=http://localhost:5073
VITE_API_TIMEOUT_MS=15000

# Auth real contra a API de treinamento (nada de mock).
VITE_USE_MOCK_AUTH=false
VITE_AUTH_LOGIN_PATH=/users/login
VITE_AUTH_ME_PATH=/users/me
VITE_AUTH_LOGIN_FIELD=email

# Lookups apontados para as rotas /api/* reais.
VITE_WAREHOUSE_ENDPOINT=/api/warehouse
VITE_CUSTOMER_LOOKUP_PATH=/api/customers
VITE_SUPPLIER_LOOKUP_PATH=/api/suppliers
VITE_ESTABLISHMENT_LOOKUP_PATH=/api/company
